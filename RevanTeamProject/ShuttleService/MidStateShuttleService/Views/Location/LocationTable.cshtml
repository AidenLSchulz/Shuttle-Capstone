@model IEnumerable<MidStateShuttleService.Models.Location>

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


@await Html.PartialAsync("~/Views/Shared/_DashboardNav.cshtml")

<!-- If true use the inverted version to show a difference -->
@if ((bool?)ViewData["Archives"] == true)
{
    <style>
        .tiled-background-2 {
            background-image: url('/img/tiled_background_variant_3.png');
        }
    </style>
}

<div class="form-container tiled-background-2">
    <div class="form-paper">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Locations</h2>
                <p class="mb-0">Manage shuttle locations.</p>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Location" asp-action="Create" class="btn btn-midstate">
                    <i class="bi bi-plus-circle-fill me-1"></i> Add Location
                </a>
            }
        </div>

        <div id="locationsTableBody">

            @if (Model == null || !Model.Any())
            {
                <div class="form-paper p-3">
                    <p>No locations currently exist.</p>
                </div>
            }
            else
            {
                @foreach (var loc in Model.OrderBy(l => l.Name))
                {
                    <div class="form-paper mb-4 p-4 position-relative location-card"
                         data-active="@(loc.IsActive ? "true" : "false")">

                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                            <div>
                                <h4 class="mb-1">@loc.Name</h4>

                                <div>
                                    <span><strong>Address:</strong> @loc.Address</span>
                                    <span> | </span>
                                    <span><strong>City:</strong> @loc.City</span>
                                    <span> | </span>
                                    <span><strong>State:</strong> @loc.State</span>
                                    <span> | </span>
                                    <span><strong>Zip:</strong> @loc.ZipCode</span>
                                    <span> | </span>
                                    <span><strong>Abbreviation:</strong> @loc.Abbreviation</span>
                                    <span> | </span>
                                </div>
                            </div>

                            @if (User.IsInRole("Admin"))
                            {
                                <div class="action-panel d-flex flex-column gap-2 align-items-start align-items-md-end">
                                    <a asp-controller="Location"
                                       asp-action="Edit"
                                       asp-route-id="@loc.LocationId"
                                       class="btn-midstate btn-midstatehover">
                                        <span class="btn-text">Update</span>
                                        <i class="bi bi-pencil-fill btn-icon"></i>
                                    </a>

                                    @if ((bool?)ViewData["Archives"] == true)
                                    {
                                        <form asp-action="Unarchive" method="post">
                                            <input type="hidden" name="id" value="@loc.LocationId" />
                                            <button class="btn-midstate btn-midstatehover" type="submit">
                                                <span class="btn-text">Unarchive</span>
                                                <i class="bi bi-arrow-up-circle-fill btn-icon"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Location"
                                              asp-action="DeleteLocation"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@loc.LocationId" />

                                            <button type="submit"
                                                    class="btn-midstate btn-midstatehover">
                                                <span class="btn-text">Archive</span>
                                                <i class="bi bi-archive-fill btn-icon"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            }

                        </div>

                    </div>
                }
            }

        </div>

        <div id="pagination-controls-location" class="pagination"></div>

    </div>
</div>

<script src="~/js/tablePagination.js"></script>
<script src="/js/Dashboard/Table.js"></script>
<script src="/js/SearchFunc/RouteSearch.js"></script>