@model IEnumerable<MidStateShuttleService.Models.Message>

@{
    // Sets page title and uses shared admin layout
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@await Html.PartialAsync("~/Views/Shared/_DashboardNav.cshtml")

<!-- If viewing archived messages, switch background style -->
@if ((bool?)ViewData["Archives"] == true)
{
    <style>
        .tiled-background-2 {
            background-image: url('/img/tiled_background_variant_3.png');
        }
    </style>
}

<div class="form-container tiled-background-2">
    <div class="form-paper">

        <!-- Page header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Messages</h2>
                <p class="mb-0">View and manage user messages.</p>
            </div>
        </div>

        <!-- Container for message cards (used by pagination JS) -->
        <div id="messageTableBody">

            @if (Model == null || !Model.Any())
            {
                <!-- Displayed when no messages exist -->
                <div class="form-paper p-3">
                    <p>There are currently no messages.</p>
                </div>
            }
            else
            {
                // Orders messages so newest appear first
                @foreach (var message in Model.OrderByDescending(m => m.id))
                {

                    <div class="form-paper mb-4 p-4 position-relative message-card">

                        <!-- Responsive layout for message card -->
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                            <div class="flex-grow-1 min-width-0">

                                <!-- Sender name -->
                                <h4 class="mb-2">@message.name</h4>

                                <div class="mb-2">
                                    <strong>Message:</strong>

                                    <!-- Message content with wrapping -->
                                    <span style="display: block; overflow-wrap: break-word; word-break: break-word;">@message.message</span>

                                </div>

                                <div>
                                    <span>
                                        <!-- Displays boolean as Yes/No -->
                                        <strong>Response Required:</strong>
                                        @(message.responseRequired ? "Yes" : "No")
                                    </span>

                                    <span> | </span>

                                    <span>
                                        <!-- Displays email or fallback -->
                                        <strong>Contact:</strong>
                                        @(string.IsNullOrEmpty(message.Email) ? "N/A" : message.Email)
                                    </span>
                                </div>

                            </div>

                            <!-- Action buttons -->
                            <div class="action-panel d-flex flex-column gap-2 align-items-start align-items-md-end">

                                <!-- Navigate to respond view -->
                                <a asp-controller="Communicate"
                                   asp-action="MessageRespond"
                                   asp-route-id="@message.id"
                                   class="btn-midstate btn-midstatehover">
                                    <span class="btn-text">Respond</span>
                                    <i class="bi bi-reply-fill btn-icon"></i>
                                </a>

                                @if ((bool?)ViewData["Archives"] == true)
                                {
                                    <!-- Restore archived message -->
                                    <form asp-action="Unarchive" method="post">
                                        <input type="hidden" name="id" value="@message.id" />
                                        <button class="btn-midstate btn-midstatehover" type="submit">
                                            <span class="btn-text">Unarchive</span>
                                            <i class="bi bi-arrow-up-circle-fill btn-icon"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <!-- Marks message as read (delete/archive behavior) -->
                                    <a asp-controller="Communicate"
                                       asp-action="Delete"
                                       asp-route-id="@message.id"
                                       class="btn-midstate btn-midstatehover">
                                        <span class="btn-text">Mark as Read</span>
                                        <i class="bi bi-check-circle-fill btn-icon"></i>
                                    </a>
                                }
                            </div>

                        </div>

                    </div>

                }
            }

        </div>

        <!-- Pagination controls populated by JS -->
        <div id="pagination-controls-message" class="pagination"></div>

    </div>
</div>

<!-- JS for pagination and message modal behavior -->
<script src="~/js/tablePagination.js"></script>
<script src="~/js/Dashboard/MessageModal.js"></script>