@using MidStateShuttleService.Enums
@{
    ViewData["Title"] = "Edit Route";
}

@model MidStateShuttleService.Models.Routes

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
<link rel="stylesheet" href="/css/routes.css" />
<link rel="stylesheet" href="/css/Modal.css" />

<body>
    <div class="wrapper wrapper--w680 mt-5">
        <div class="form form-1">
            <div class="form-body">
                <h2 class="title">Edit Route</h2>

                <!-- Route edit form — posts to RoutesController.Edit with the current RouteID -->
                <form asp-action="Edit" method="post">

                    <!-- Hidden field preserves the RouteID across the POST for the ID mismatch guard in the controller -->
                    <input type="hidden" asp-for="RouteID" />

                    <!-- Day of Week — populated from the WeekDay enum, pre-selected with the existing value -->
                    <div class="input-fields">
                        <label>Day of Week</label>
                        <select asp-for="DayOfWeek"
                                asp-items="Html.GetEnumSelectList<WeekDay>()"
                                class="form-control input--style-1"
                                required>
                            <option value="">--Select Day--</option>
                        </select>
                        <div class="div-line"></div>
                        <div id="DayOfWeek-validation-message" class="validation-message">
                            Please select a day of the week.
                        </div>
                    </div>

                    <!-- Pick Up Location — populated from ViewBag.Locations by LoadRouteDropdowns(), pre-selected with the existing value -->
                    <div class="input-fields">
                        <label>Pick Up Location</label>
                        <select asp-for="PickUpLocationID"
                                asp-items="ViewBag.Locations"
                                class="form-control input--style-1" required>
                            <option selected="selected" value="" required>--Select--</option>
                        </select>
                        <div class="div-line"></div>
                        <div id="PickUpLocationID-validation-message" class="validation-message">Please select a pick-up location.</div>
                    </div>

                    <!-- Drop Off Location — populated from the same ViewBag.Locations list, pre-selected with the existing value -->
                    <div class="input-fields">
                        <label>Drop Off Location</label>
                        <select asp-for="DropOffLocationID"
                                asp-items="ViewBag.Locations"
                                class="form-control input--style-1" required>
                            <option selected="selected" value="" required>--Select--</option>
                        </select>
                        <div class="div-line"></div>
                        <div id="DropOffLocationID-validation-message" class="validation-message">Please select a drop-off location.</div>
                    </div>

                    <!-- Pick Up Time — stored as TimeSpan on the model, pre-populated with the existing value -->
                    <div class="input-fields">
                        <label>Pick Up Time</label>
                        <input asp-for="PickUpTime" type="time" class="form-control input--style-1" required />
                        <div class="div-line"></div>
                        <div id="PickUpTime-validation-message" class="validation-message">Please enter a valid pick-up time.</div>
                    </div>

                    <!-- Drop Off Time — stored as TimeSpan on the model, pre-populated with the existing value -->
                    <div class="input-fields">
                        <label>Drop Off Time</label>
                        <input asp-for="DropOffTime" type="time" class="form-control input--style-1" required />
                        <div class="div-line"></div>
                        <div id="DropOffTime-validation-message" class="validation-message">Please enter a valid drop-off time.</div>
                    </div>

                    <!-- Additional Details — optional free-text field for route notes -->
                    <div class="input-fields">
                        <label>Additional Details</label>
                        <textarea asp-for="AdditionalDetails" class="form-control input--style-1" placeholder="Enter additional details"></textarea>
                        <div class="div-line"></div>
                        <div id="AdditionalDetails-validation-message" class="validation-message">Please enter valid additional details.</div>
                    </div>

                    <!-- Form actions — Return navigates to the full route list without saving -->
                    <div class="p-t-20">
                        <button type="submit" class="btn btn--radius btn--submit">Save</button>
                        <button type="button" class="btn btn-primary"
                                onclick="location.href='@Url.Action("ViewAll", "Routes")'">
                            Return
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- Success modal — shown automatically when TempData["RouteSuccess"] is set after a successful update -->
    <div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="successModalLabel">Edit Successful</h5>
                    <!-- Dismiss button closes the modal and returns focus to the edit form -->
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    Route updated successfully!
                </div>
                <div class="modal-footer">
                    <!-- Return navigates to the full route list -->
                    <button type="button" class="btn btn-primary"
                            onclick="location.href='@Url.Action("ViewAll", "Routes")'">
                        Return
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            // Check TempData flag set by the controller on successful update and trigger the success modal.
            // TempData is consumed after this read so the modal will not re-appear on page refresh.
            var routeSuccess = '@TempData["RouteSuccess"]';
            if (routeSuccess === 'True') {
                $('#successModal').modal('show');
            }
        });
    </script>

    <script src="~/js/Routes.js"></script>
</body>