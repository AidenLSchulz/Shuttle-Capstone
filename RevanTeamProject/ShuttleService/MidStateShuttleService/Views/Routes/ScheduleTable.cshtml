@model IEnumerable<MidStateShuttleService.Models.Routes>
@{
    ViewData["Title"] = "Route Schedule";
    <!-- Sets page title -->
}
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
<link rel="stylesheet" href="/css/Form.css" />
<link rel="stylesheet" href="/css/Input.css" />
<link rel="stylesheet" href="/css/HelpIcon.css" />
<link rel="stylesheet" href="/css/RouteSchedule.css" />
<!-- Styles for layout, inputs, help icons, and schedule display -->
<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
<!-- jQuery + Bootstrap JS for UI interactions -->


<div class="form-container tiled-background-1">
    <div class="form-paper">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 id="schedule-heading">Route Schedule</h2>
                <p class="mb-0">View shuttle routes organized by day of the week.</p>
            </div>
        </div>
        <!-- Header section -->
        @{
            var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday" };
            <!-- Defines display order for days -->
            var groupedByDay = Model
            .GroupBy(r => r.DayOfWeek)
            .OrderBy(g => Array.IndexOf(days, g.Key.ToString()));
            <!-- Groups routes by day and sorts them -->
            // Collect unique pickup locations for filter dropdown
            var allPickupLocations = Model
            .Select(r => r.PickUpLocation.Name)
            .Distinct()
            .OrderBy(n => n)
            .ToList();
            <!-- Builds unique pickup location list for filtering -->
        }

        @if (!Model.Any())
        {
            <div class="form-paper p-3" role="status">
                <p>There are currently no routes scheduled.</p>
            </div>
            <!-- Empty state when no routes exist -->
        }
        else
        {
            <!-- ── Filter bar ─────────────────────────────────────── -->
            <div class="filter-bar" role="search" aria-label="Filter schedule">

                <div class="filter-group">
                    <label for="filter-day">Day of Week</label>
                    <select class="dropdown-midstate" id="filter-day" aria-label="Filter by day of week">
                        <option value="">All Days</option>
                        @foreach (var d in days)
                        {
                            if (groupedByDay.Any(g => g.Key.ToString() == d))
                            {
                                <option value="@d">@d</option>
                            }
                        }
                    </select>
                    <!-- Filters routes by selected day -->
                </div>

                <div class="filter-group">
                    <label for="filter-location">Pickup Location</label>
                    <select class="dropdown-midstate" id="filter-location" aria-label="Filter by pickup location">
                        <option value="">All Locations</option>
                        @foreach (var loc in allPickupLocations)
                        {
                            <option value="@loc">@loc</option>
                        }
                    </select>
                    <!-- Filters routes by pickup location -->
                </div>

                <button class="btn-midstate" id="filter-search" type="button" aria-label="Search schedule">
                    Search
                </button>
                <!-- Triggers filtering -->

                <button class="btn-midstate" id="filter-clear" type="button" aria-label="Clear filters">
                    ✕ Clear
                </button>
                <!-- Clears all filters -->
            </div>

            <!-- ── Schedule content ──────────────────────────────── -->
            <div id="schedule-content" tabindex="-1">

                @foreach (var dayGroup in groupedByDay)
                {
                    var dayKey = dayGroup.Key.ToString().Replace(" ", "-");

                    <section class="mb-4 day-section"
                             id="day-section-@dayKey"
                             data-day="@dayGroup.Key"
                             aria-labelledby="day-@dayKey"
                             tabindex="0">
                        <!-- Section per day -->

                        <h4 class="mb-3" id="day-@dayKey">
                            <i class="bi bi-calendar-week me-2" aria-hidden="true"> </i>@dayGroup.Key
                        </h4>

                        @{
                            var groupedByPickup = dayGroup
                            .GroupBy(r => r.PickUpLocation.Name)
                            .OrderBy(g => g.Min(r => r.PickUpTime));
                            <!-- Groups routes by pickup location -->
                        }

                        @foreach (var pickupGroup in groupedByPickup)
                        {
                            var tableId = $"table-{dayGroup.Key.ToString().Replace(" ", "-")}-{pickupGroup.Key.Replace(" ", "-")}";
                            var headerId = $"header-{tableId}";
                            var bodyId = $"body-{tableId}";
                            var cardId = $"card-{tableId}";

                            <div class="route-card"
                                 id="@cardId"
                                 data-day="@dayGroup.Key"
                                 data-location="@pickupGroup.Key">
                                <!-- Card for each pickup location -->
                                <!-- Accordion toggle header -->
                                <div class="route-card-header"
                                     id="@headerId"
                                     role="button"
                                     tabindex="0"
                                     aria-expanded="false"
                                     aria-controls="@bodyId"
                                     data-target="#@bodyId">
                                    <strong>
                                        <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                                        @pickupGroup.Key
                                    </strong>
                                    <span class="chevron" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                    </span>
                                </div>

                                <!-- Collapsible body -->
                                <div class="route-card-body" id="@bodyId" role="region" aria-labelledby="@headerId">
                                    <div class="inner">
                                        <div class="table-responsive">
                                            <table class="table table-striped mb-0" id="@tableId">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">Shuttle Leaves</th>
                                                        <th scope="col">Shuttle Arrives</th>
                                                        <th scope="col">Final Destination</th>
                                                        @if (User.IsInRole("Admin"))
                                                        {
                                                            <th scope="col"></th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var route in pickupGroup.OrderBy(r => r.PickUpTime))
                                                    {
                                                        var leaveTime = route.PickUpTime.HasValue ? DateTime.Today.Add(route.PickUpTime.Value).ToString("hh:mm tt") : "N/A";
                                                        var arriveTime = route.DropOffTime.HasValue ? DateTime.Today.Add(route.DropOffTime.Value).ToString("hh:mm tt") : "N/A";

                                                        <tr tabindex="0"
                                                            aria-label="Leaving @leaveTime, arriving @arriveTime, Final Destination: @route.DropOffLocation.Name">
                                                            <td>@leaveTime</td>
                                                            <td>@arriveTime</td>
                                                            <td>@route.DropOffLocation.Name</td>
                                                            @if (User.IsInRole("Admin"))
                                                            {
                                                                <td>
                                                                    <a href="/Communicate?routeId=@route.RouteID"
                                                                       class="btn-midstate btn-primary"
                                                                       style="white-space: nowrap;">
                                                                        Message Riders
                                                                    </a>
                                                                </td>
                                                                <!-- Admin-only action -->
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        }

                    </section>
                }

            </div>
        }

    </div>
</div>

<script src="/js/RouteSchedule.js"></script>
<!-- Handles filtering and accordion behavior -->