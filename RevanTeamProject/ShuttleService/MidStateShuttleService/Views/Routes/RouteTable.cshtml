@model IEnumerable<MidStateShuttleService.Models.Routes>

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@{
    var routes = Model?
        .OrderBy(r => r.PickUpLocationID)
        .ThenBy(r => r.PickUpTime)
        .ToList();
}


@await Html.PartialAsync("~/Views/Shared/_DashboardNav.cshtml")

<link rel="stylesheet" href="/css/RouteVisibility.css" />

<!-- If true use the inverted version to show a difference -->
@if ((bool?)ViewData["Archives"] == true)
{
    <style>
        .tiled-background-2 {
            background-image: url('/img/tiled_background_variant_3.png');
        }
    </style>
}

<div class="form-container tiled-background-2">
    <div class="form-paper">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Routes</h2>
                <p class="mb-0">Manage shuttle routes.</p>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="d-flex gap-2">
                    <!-- Add Route -->
                    <a asp-controller="Routes" asp-action="Create" class="btn btn-midstate">
                        Add Route
                    </a>

                    <!-- Upload Routes -->
                    <form asp-controller="Routes"
                          asp-action="UploadRoutesExcel"
                          method="post"
                          enctype="multipart/form-data"
                          style="display:inline;">

                        @Html.AntiForgeryToken()

                        <input type="file"
                               name="excelFile"
                               id="excelFileInput"
                               accept=".xlsx"
                               style="display:none;"
                               onchange="this.form.submit();" />

                        <button type="button"
                                class="btn btn-midstate"
                                title="Upload .xlsx file with DEP, START, END, ARRIVAL, MON–THUR columns"
                                onclick="document.getElementById('excelFileInput').click();">
                            Upload Routes
                        </button>
                    </form>
                </div>
            }
        </div>

        <!-- Route Filter -->
        <div class="form-paper mb-3 p-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="mb-1"><strong>Pickup Location</strong></label>
                    <select id="routePickupFilter" class="form-control">
                        <option value="">All Pickup Locations</option>

                        @foreach (var loc in routes.Select(r => r.PickUpLocation).DistinctBy(l => l.LocationId))
                        {
                            <option value="@loc.LocationId">@loc.ToStringPickup()</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="mb-1"><strong>Pickup Time Range</strong></label>

                    <div class="d-flex gap-2">
                        <input id="routeTimeFrom"
                               type="time"
                               class="form-control" />

                        <input id="routeTimeTo"
                               type="time"
                               class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div id="routesTableBody">

            @if (Model == null || !Model.Any())
            {
                <div class="form-paper p-3">
                    <p>No routes currently exist.</p>
                </div>
            }
            else
            {
                @foreach (var route in routes)
                {
                    <div class="form-paper mb-4 p-4 position-relative route-card @(!route.Enabled ? "route-disabled" : "")"
                         data-pickup="@route.PickUpLocationID"
                         data-time="@route.PickUpTime?.ToString(@"hh\:mm")"
                         data-dropoff="@route.DropOffLocationID"
                         data-day="@route.DayOfWeek"
                         data-active="@(route.IsActive ? "true" : "false")">

                        <!-- VISIBILITY INDICATOR (top-left) -->
                        <div class="visibility-indicator">
                            @if (route.Enabled)
                            {
                                <i class="bi bi-eye-fill text-success" title="Visible to students"></i>
                            }
                            else
                            {
                                <i class="bi bi-eye-slash text-muted" title="Hidden from students"></i>
                            }
                            <br />
                        </div>

                        <div class="route-card-inner d-flex flex-column flex-md-row justify-content-between gap-3">

                            <!-- LEFT SIDE (INFO) -->
                            <div class="route-info flex-grow-1">

                                <h4 class="mb-1">
                                    @route.PickUpLocation.ToStringPickup() → @route.DropOffLocation.ToStringDropoff()
                                </h4>

                                <div>
                                    <span><strong>Day:</strong> @route.DayOfWeek.ToString()</span>
                                    <span> | </span>
                                    <span><strong>Pickup:</strong> @route.ToStringPickUpTime()</span>
                                    <span> | </span>
                                    <span><strong>Dropoff:</strong> @route.ToStringDropOffTime()</span>
                                </div>

                                @if (!string.IsNullOrEmpty(route.AdditionalDetails))
                                {
                                    <div class="mt-2 text-muted">
                                        <strong>Notes:</strong> @route.AdditionalDetails
                                    </div>
                                }

                            </div>

                            <!-- RIGHT SIDE (ACTIONS) -->
                            <div class="action-panel d-flex flex-column gap-2 align-items-start align-items-md-end">

                                <a asp-controller="Register"
                                   asp-action="ViewPassengerList"
                                   asp-route-routeId="@route.RouteID"
                                   class="btn-midstate btn-midstatehover">
                                    <i class="bi bi-people-fill btn-icon"></i>
                                    <span class="btn-text">Reservations</span>
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-controller="Routes"
                                       asp-action="Edit"
                                       asp-route-id="@route.RouteID"
                                       class="btn-midstate btn-midstatehover">
                                        <i class="bi bi-pencil-fill btn-icon"></i>
                                        <span class="btn-text">Update</span>
                                    </a>

                                    <a href="/Communicate?routeId=@route.RouteID"
                                       class="btn-midstate btn-midstatehover">
                                        <i class="bi bi-chat-dots-fill btn-icon"></i>
                                        <span class="btn-text">Message Riders</span>
                                    </a>

                                    <form asp-controller="Routes"
                                          asp-action="ToggleVisibility"
                                          asp-route-id="@route.RouteID"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn-midstate btn-midstatehover">
                                            <i class="bi bi-eye-fill btn-icon"></i>
                                            <span class="btn-text">Toggle Visibility</span>
                                        </button>
                                    </form>

                                    @if ((bool?)ViewData["Archives"] == true)
                                    {
                                        <form asp-action="Unarchive" method="post">
                                            <input type="hidden" name="id" value="@route.RouteID" />
                                            <button class="btn-midstate btn-midstatehover" type="submit">
                                                <i class="bi bi-arrow-up-circle-fill btn-icon"></i>
                                                <span class="btn-text">Unarchive</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Routes"
                                              asp-action="Delete"
                                              asp-route-id="@route.RouteID"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn-midstate btn-midstatehover">
                                                <i class="bi bi-archive-fill btn-icon"></i>
                                                <span class="btn-text">Archive</span>
                                            </button>
                                        </form>
                                    }
                                }

                            </div>

                        </div>
                    </div>
                }
            }

        </div>

        <div id="pagination-controls-routes" class="pagination"></div>

    </div>
</div>

<script src="/js/Dashboard/Table.js"></script>
<script>
    setTimeout(() => {
        document.querySelectorAll('.alert').forEach(a => a.remove());
    }, 8000);
</script>
<script src="~/js/RoutesManagement.js"></script>