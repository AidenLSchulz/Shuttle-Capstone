@model MidStateShuttleService.Models.AllModels
@using System.Linq
@using MidStateShuttleService.Models

@{
    // Sets page title and layout
    ViewData["Title"] = "Reports";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Determines which report is selected (requests, checkins, or mail)
    var reportType = (ViewBag.ReportType as string) ?? "";

    var isRequests = reportType.Equals("requests", StringComparison.OrdinalIgnoreCase);
    var isCheckins = reportType.Equals("checkins", StringComparison.OrdinalIgnoreCase);
    var isMail = reportType.Equals("mail", StringComparison.OrdinalIgnoreCase);

    // DEV NOTE:
    // Always convert collections to lists to avoid null issues
    var requestRows = ((IEnumerable<RegisterModel>?)ViewBag.RequestRoutes ?? Enumerable.Empty<RegisterModel>()).ToList();
    var checkinRows = (Model.CheckIn ?? Enumerable.Empty<CheckIn>()).ToList();
    var mailRows = (Model.MailItems ?? Enumerable.Empty<MailItem>()).ToList();
}

<!-- Styles for dashboard and reports -->
<link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Reports..css" asp-append-version="true" />

<div class="reportsPage">

    <!-- HEADER -->
    <div class="reportsPageTopBar">
        <div class="reportsHeaderLeft">
            <h2 class="reportsTitle">Reports</h2>
            <div class="reportsHint">Run admin reports and export CSV files.</div>
        </div>

        <!-- Navigation back to dashboard -->
        <a class="rptBtn rptBtnGhost"
           href="@Url.Action("Index", "Dashboard")">
            ← Back to Dashboard
        </a>
    </div>

    <!-- REPORT PICKER -->
    <div class="reportCard">
        <div class="reportCardHeader">
            <div class="reportCardHeaderText">
                <div class="reportCardHeaderTitle">Report Picker</div>
                <div class="reportCardHeaderSub">Choose a report type to view results.</div>
            </div>
        </div>

        <div class="reportCardBody">
            <div class="reportPickerGrid">

                <!-- REQUESTS OPTION -->
                <div class="reportOption @(isRequests ? "reportOptionActive" : "")">
                    <div class="reportOptionTop">
                        <div class="reportOptionText">
                            <p class="reportOptionTitle">Rider Requests</p>
                            <p class="reportOptionDesc">All registrations (newest first)</p>
                        </div>
                        <div class="reportOptionMeta">
                            <span class="pill pill-neutral">All time</span>
                        </div>
                    </div>

                    <!-- Run and Export actions -->
                    <div class="reportOptionActions">
                        <a class="rptBtn"
                           href="@Url.Action("Reports", "Reports", new { report = "requests" })">
                            Run
                        </a>

                        <a class="rptBtn rptBtnOutline"
                           href="@Url.Action("ExportRiderRequestsCsv", "Reports")">
                            Export CSV
                        </a>
                    </div>
                </div>

                <!-- CHECKINS OPTION -->
                <div class="reportOption @(isCheckins ? "reportOptionActive" : "")">
                    <div class="reportOptionTop">
                        <div class="reportOptionText">
                            <p class="reportOptionTitle">Check-ins</p>
                            <p class="reportOptionDesc">All check-ins (newest first)</p>
                        </div>
                        <div class="reportOptionMeta">
                            <span class="pill pill-neutral">All time</span>
                        </div>
                    </div>

                    <div class="reportOptionActions">
                        <a class="rptBtn"
                           href="@Url.Action("Reports", "Reports", new { report = "checkins" })">
                            Run
                        </a>

                        <a class="rptBtn rptBtnOutline"
                           href="@Url.Action("ExportCheckInsCsv", "Reports")">
                            Export CSV
                        </a>
                    </div>
                </div>

                <!-- MAIL OPTION -->
                <div class="reportOption @(isMail ? "reportOptionActive" : "")">
                    <div class="reportOptionTop">
                        <div class="reportOptionText">
                            <p class="reportOptionTitle">Mail Check-Ins</p>
                            <p class="reportOptionDesc">All mail entries (newest first)</p>
                        </div>
                        <div class="reportOptionMeta">
                            <span class="pill pill-neutral">All time</span>
                        </div>
                    </div>

                    <div class="reportOptionActions">
                        <a class="rptBtn"
                           href="@Url.Action("Reports", "Reports", new { report = "mail" })">
                            Run
                        </a>

                        <a class="rptBtn rptBtnOutline"
                           href="@Url.Action("ExportMailCsv", "Reports")">
                            Export CSV
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @if (isRequests)
    {
        <!-- REQUEST RESULTS -->
        <div class="reportCard reportResultsBlock">
            <div class="reportStickyBar">
                <div class="reportStickyLeft">
                    <h3>Rider Requests</h3>
                </div>
                <div class="reportStickyRight">
                    <!-- Displays total row count -->
                    <span class="pill">Rows: @requestRows.Count</span>
                </div>
            </div>

            <!-- Scrollable table -->
            <div class="reportScrollArea">
                <table class="reportsTable">
                    <thead>
                        <tr>
                            <th>Registration ID</th>
                            <th>Ride ID</th>
                            <th>Route ID</th>
                            <th>Name</th>
                            <th>StudentId</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Over 18</th>
                            <th>Type</th>
                            <th>Field Trip</th>
                            <th>Internal</th>
                            <th>Day</th>
                            <th>Pickup</th>
                            <th>Dropoff</th>
                            <th>Dropoff Time</th>
                            <th>Date</th>
                            <th>Archived</th>
                            <th>Additional Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var registration in requestRows)
                        {
                            var requestDays = registration.DaySchedules ?? new List<RequestDay>();

                            if (requestDays.Any())
                            {
                                foreach (var requestDay in requestDays)
                                {
                                    var rides = requestDay.Rides ?? new List<Ride>();

                                    if (rides.Any())
                                    {
                                        foreach (var ride in rides)
                                        {
                                            <tr>
                                                <td>@registration.RegistrationId</td>
                                                <td>@ride.RideId</td>
                                                <td>@ride.RouteId</td>
                                                <td>@registration.Name</td>
                                                <td>@registration.StudentId</td>
                                                <td>@registration.Email</td>
                                                <td>@registration.Phone</td>
                                                <td>@(registration.IsAdult ? "Yes" : "No")</td>
                                                <td>@(registration.isCustom ? "Special" : "Regular")</td>
                                                <td>@(registration.IsFieldTrip ? "Yes" : "No")</td>
                                                <td>@(registration.IsInternalInquiry ? "Yes" : "No")</td>
                                                <td>@requestDay.WeekDay</td>
                                                <td>@ride.PickUpLocation?.Name</td>
                                                <td>@ride.DropOffLocation?.Name</td>
                                                <td>@ride.DropOffTime?.ToString("h\\:mm")</td>
                                                <td>@MidStateShuttleService.Helpers.DateTimeHelper.ToCentralTimeString(registration.InsertDateTime)</td>
                                                <td>@(registration.IsArchived ? "Yes" : "No")</td>
                                                <td>@registration.customMessage</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>@registration.RegistrationId</td>
                                            <td></td>
                                            <td></td>
                                            <td>@registration.Name</td>
                                            <td>@registration.StudentId</td>
                                            <td>@registration.Email</td>
                                            <td>@registration.Phone</td>
                                            <td>@(registration.IsAdult ? "Yes" : "No")</td>
                                            <td>@(registration.isCustom ? "Special" : "Regular")</td>
                                            <td>@(registration.IsFieldTrip ? "Yes" : "No")</td>
                                            <td>@(registration.IsInternalInquiry ? "Yes" : "No")</td>
                                            <td>@requestDay.WeekDay</td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td>@MidStateShuttleService.Helpers.DateTimeHelper.ToCentralTimeString(registration.InsertDateTime)</td>
                                            <td>@(registration.IsArchived ? "Yes" : "No")</td>
                                            <td>@registration.customMessage</td>
                                        </tr>
                                    }
                                }
                            }
                            else
                            {
                                <tr>
                                    <td>@registration.RegistrationId</td>
                                    <td></td>
                                    <td></td>
                                    <td>@registration.Name</td>
                                    <td>@registration.StudentId</td>
                                    <td>@registration.Email</td>
                                    <td>@registration.Phone</td>
                                    <td>@(registration.IsAdult ? "Yes" : "No")</td>
                                    <td>@(registration.isCustom ? "Special" : "Regular")</td>
                                    <td>@(registration.IsFieldTrip ? "Yes" : "No")</td>
                                    <td>@(registration.IsInternalInquiry ? "Yes" : "No")</td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td>@MidStateShuttleService.Helpers.DateTimeHelper.ToCentralTimeString(registration.InsertDateTime)</td>
                                    <td>@(registration.IsArchived ? "Yes" : "No")</td>
                                    <td>@registration.customMessage</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    else if (isCheckins)
    {
        <!-- CHECKIN RESULTS -->
        <div class="reportCard reportResultsBlock">
            <div class="reportStickyBar">
                <h3>Check-ins</h3>
            </div>

            <div class="reportScrollArea">
                <table class="reportsTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>StudentId</th>
                            <th>Date</th>
                            <th>First Time</th>
                            <th>Pickup</th>
                            <th>Dropoff</th>
                            <th>Comments</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var checkIn in checkinRows)
                        {
                            <tr>
                                <td>@checkIn.CheckInId</td>
                                <td>@checkIn.Name</td>
                                <td>@checkIn.StudentId</td>
                                <td>@MidStateShuttleService.Helpers.DateTimeHelper.ToCentralTimeString(checkIn.Date)</td>
                                <td>@(checkIn.FirstTime ? "Yes" : "No")</td>
                                <td>@checkIn.Location?.Name</td>
                                <td>@checkIn.DropOffLocation?.Name</td>
                                <td>@checkIn.Comments</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    else if (isMail)
    {
        <!-- MAIL RESULTS -->
        <div class="reportCard reportResultsBlock">
            <div class="reportStickyBar">
                <h3>Mail Check-Ins</h3>
            </div>

            <div class="reportScrollArea">
                <table class="reportsTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Driver</th>
                            <th>Pickup</th>
                            <th>Dropoff</th>
                            <th>Type</th>
                            <th>Notes</th>
                            <th>Submitted By</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mailItem in mailRows)
                        {
                            <tr>
                                <td>@mailItem.MailItemId</td>
                                <td>@mailItem.DriverName</td>
                                <td>@mailItem.PickupLocation</td>
                                <td>@mailItem.DropoffLocation</td>
                                <td>@mailItem.MailType</td>
                                <td>@mailItem.Notes</td>
                                <td>@mailItem.SubmittedBy</td>
                                <td>@MidStateShuttleService.Helpers.DateTimeHelper.ToCentralTimeString(mailItem.SubmittedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>